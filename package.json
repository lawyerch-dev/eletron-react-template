{
  "name": "electron-react-template",
  "version": "1.1.0",
  "private": true,
  "description": "Electron + React + TypeScript \u684c\u9762\u5e94\u7528\u6a21\u677f\uff08\u63d2\u4ef6\u5bbf\u4e3b + \u80fd\u529b\u88c1\u526a + \u8bed\u4e49\u4e3b\u9898\uff09\u3002",
  "license": "MIT",
  "author": "BluerAngala",
  "type": "module",
  "main": "out/electron/main/main.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/BluerAngala/electron-react-template.git"
  },
  "bugs": {
    "url": "https://github.com/BluerAngala/electron-react-template/issues"
  },
  "homepage": "https://github.com/BluerAngala/electron-react-template#readme",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "pretest": "vite build --mode=test",
    "test": "vitest run",
    "test:e2e": "pnpm pretest && playwright test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src packages --ext .ts,.tsx",
    "lint:fix": "eslint src packages --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json,html}\" \"!src/plugins/**\" \"packages/**/*.{ts,tsx,json,md}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json,html}\" \"!src/plugins/**\" \"packages/**/*.{ts,tsx,json,md}\" \"tests/**/*.ts\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "dependencies": {
    "@ert/plugin-api": "workspace:*",
    "@ert/shared": "workspace:*",
    "@electron/asar": "^4.3.0",
    "adm-zip": "^0.6.0",
    "electron-log": "^5.4.4",
    "electron-store": "^11.0.2",
    "electron-updater": "^6.8.3",
    "lucide-react": "^1.25.0",
    "marked": "^18.0.10",
    "minimatch": "^10.2.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@electron/get": "^4.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.2",
    "electron": "^42.1.0",
    "electron-builder": "26.15.4",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-electron": "^1.0.1",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitepress": "^1.6.4",
    "vitest": "^4.1.8"
  },
  "pnpm": {
    "overrides": {
      "@electron/get": "4.0.3"
    }
  }
}
