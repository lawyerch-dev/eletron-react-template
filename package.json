{
  "name": "electron-react-template",
  "version": "1.1.0",
  "private": true,
  "description": "Electron + React + TypeScript 桌面应用 monorepo 模板（插件宿主 + 能力裁剪 + 语义主题）。",
  "license": "MIT",
  "author": "BluerAngala",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/BluerAngala/electron-react-template.git"
  },
  "bugs": {
    "url": "https://github.com/BluerAngala/electron-react-template/issues"
  },
  "homepage": "https://github.com/BluerAngala/electron-react-template#readme",
  "scripts": {
    "dev": "pnpm --filter desktop dev",
    "build": "pnpm --filter desktop build",
    "preview": "pnpm --filter desktop preview",
    "test": "pnpm --filter desktop test",
    "test:e2e": "pnpm --filter desktop test:e2e",
    "typecheck": "pnpm --filter desktop typecheck",
    "lint": "eslint apps/desktop packages --ext .ts,.tsx",
    "lint:fix": "eslint apps/desktop packages --ext .ts,.tsx --fix",
    "format": "prettier --write \"apps/desktop/src/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"apps/desktop/src/**/*.{ts,tsx,css,json}\" \"packages/**/*.{ts,tsx,json,md}\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "prettier": "^3.9.5",
    "vitepress": "^1.6.4"
  },
  "pnpm": {
    "overrides": {
      "@electron/get": "4.0.3"
    }
  }
}
