{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bluerangala.eletron-react-template",
  "asar": true,
  "extraResources": [
    {
      "from": "electron/main/plugin/plugin-preload.js",
      "to": "plugin-preload.js"
    },
    {
      "from": "plugins",
      "to": "plugins",
      "filter": ["**/*"]
    },
    {
      "from": "resources/lib",
      "to": "lib",
      "filter": ["**/*"]
    }
  ],
  "asarUnpack": [
    "resources/lib/**"
  ],
  "directories": {
    "output": "release/${version}"
  },
  "files": [
    "dist-electron",
    "dist"
  ],
  "mac": {
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      "dmg",
      "zip"
    ],
    "notarize": true
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "github",
    "owner": "BluerAngala",
    "repo": "eletron-react-template",
    "releaseType": "release"
  }
}
