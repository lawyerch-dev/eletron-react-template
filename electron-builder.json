{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.bluerangala.electron-react-template",
  "asar": true,
  "extraResources": [
    {
      "from": "src/main/features/plugin-host/plugin-preload.js",
      "to": "plugin-preload.js"
    },
    {
      "from": "src/plugins",
      "to": "plugins",
      "filter": [
        "**/*",
        "!**/.venv/**",
        "!**/venv/**",
        "!**/__pycache__/**",
        "!**/*.pyc",
        "!**/uv.lock",
        "!**/.git/**"
      ]
    },
    {
      "from": "resources/lib",
      "to": "lib",
      "filter": [
        "**/*"
      ]
    },
    {
      "from": "resources/ocr",
      "to": "ocr",
      "filter": [
        "**/*"
      ]
    }
  ],
  "asarUnpack": [
    "resources/lib/**"
  ],
  "directories": {
    "buildResources": "build",
    "output": "release/${version}"
  },
  "files": [
    "out/electron",
    "out/renderer",
    "package.json"
  ],
  "mac": {
    "artifactName": "${productName}_${version}.${ext}",
    "target": [
      "dmg",
      "zip"
    ],
    "notarize": true
  },
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": [
          "x64"
        ]
      }
    ],
    "artifactName": "${productName}_${version}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false
  },
  "publish": {
    "provider": "github",
    "owner": "BluerAngala",
    "repo": "electron-react-template",
    "releaseType": "release"
  },
  "productName": "Electron React Template"
}
